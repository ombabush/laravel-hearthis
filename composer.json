{
    "name": "ombabush/laravel-hearthis",
    "description": "A small Laravel client for the hearthis.at public API: tracks, playlists and embeds, without a key.",
    "type": "library",
    "license": "MIT",
    "authors": [{ "name": "ombabush" }],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": { "Ombabush\\Hearthis\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Ombabush\\Hearthis\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Ombabush\\Hearthis\\HearthisServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": { "allow-plugins": { "pestphp/pest-plugin": true } }
}
